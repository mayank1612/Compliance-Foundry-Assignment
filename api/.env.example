# What: template for api/.env (copy it: `cp api/.env.example api/.env`).
# Why:  every variable is OPTIONAL — with no .env at all the API runs on an
#       embedded PGlite database. This file documents what can be overridden.
# Note: real environment variables take precedence over values in api/.env.

# Point at a real Postgres server instead of embedded PGlite, e.g. a Docker
# container: postgres://postgres:postgres@localhost:5432/taskboard
DATABASE_URL=

# Where embedded PGlite stores its files (relative to api/). Ignored if DATABASE_URL is set.
PGLITE_DATA_DIR=.pglite

# Connection-pool size for a real server. PGlite always uses exactly 1.
DB_POOL_MAX=10
