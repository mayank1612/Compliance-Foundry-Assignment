{
  "name": "@taskboard/api",
  "version": "0.1.0",
  "private": true,
  "description": "GraphQL API + Postgres schema for the task-board take-home.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:reset": "tsx src/scripts/reset.ts",
    "db:serve": "tsx src/scripts/serve.ts",
    "db:codegen": "tsx src/scripts/codegen.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "gql:codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "dataloader": "^2.2.3",
    "fractional-indexing": "^4.0.0",
    "graphql": "^17.1.0",
    "graphql-yoga": "^6.1.0",
    "jose": "^6.2.17",
    "kysely": "^0.29.9",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-resolvers": "^7.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
