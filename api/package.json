{
  "name": "@taskboard/api",
  "version": "0.1.0",
  "private": true,
  "description": "GraphQL API + Postgres schema for the task-board take-home.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:reset": "tsx src/scripts/reset.ts",
    "db:serve": "tsx src/scripts/serve.ts",
    "db:codegen": "tsx src/scripts/codegen.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "kysely": "^0.29.9",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "graphql": "^17.1.0",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
